	keywords = {��️},
	file = {ScienceDirect Full Text PDF:/Users/emilyyu415/Zotero/storage/H8EN8FSQ/Lindberg et al. - 2006 - How age affects the speed of perception of computer icons.pdf:application/pdf;ScienceDirect Snapshot:/Users/emilyyu415/Zotero/storage/Q94EX4N8/S0141938206000333.html:text/html},
}

@inproceedings{mahmud_learning_2020,
