@article{peterson_impact_nodate,
	title = {The impact of {AI}-generated responses on environmental survey data from {MTurk}},
	volume = {0},
    year = {2023},
	issn = {2998-4688},
	url = {https://doi.org/10.1080/29984688.2025.2545754},
	doi = {10.1080/29984688.2025.2545754},
	abstract = {This study investigates the impact of nonhuman, {AI}-generated responses on data quality in a climate change survey conducted via Amazon’s Mechanical Turk ({MTurk}). As {MTurk} remains a popular platform for academic research, the rise of bots threatens data validity. The research focuses on two questions: (1) What is the prevalence of {AI}-generated responses in {MTurk} surveys? and (2) How can researchers mitigate their effects? To address these questions, a climate change survey was distributed in May 2024. Of the initial sample, 50\% of {MTurk} workers failed to complete the survey. Open-ended questions and basic logic checks identified likely bot activity among completed responses. 37\% of submitted responses met basic validity criteria, and just 20\% of the total requested sample met all quality standards. In total, 290 out of 1,443 responses (20\%) were usable. The survey responses revealed a 63\% rate of likely {AI}-generated responses. The methodology highlights the importance of combining qualitative review with quantitative screening to detect nonhuman input. This study contributes to the academy by proposing safeguards like captchas and open-ended verification questions to enhance data reliability. The findings emphasize the need for researchers to carefully weigh platform quality, cost efficiency, and ethical considerations when conducting online surveys.},
	pages = {1--16},
	number = {0},
    journal = {Journal of Applied Statistics: Environmental Statistics and Data Science},
	journaltitle = {Journal of Applied Statistics: Environmental Statistics and Data Science},
	author = {Peterson, Ted},
	urldate = {2025-11-05},
	note = {Publisher: Taylor \& Francis
\_eprint: https://doi.org/10.1080/29984688.2025.2545754},
	keywords = {artificial intelligence in surveys, bot responses, Data integrity, fraudulent survey data responses, human vs. {AI}-generated responses, {MTurk} online survey quality},
	file = {Full Text PDF:/Users/emilyyu415/Zotero/storage/GBDMPJDF/Peterson - The impact of AI-generated responses on environmental survey data from MTurk.pdf:application/pdf},
}


@misc{asher_chatbots_2025,
	title = {Chatbots Are Undermining Crowdsourced Research in the Behavioral Sciences: Detecting {AI}-Assisted Cheating with a Keystroke-Based Tool},
	rights = {https://creativecommons.org/licenses/by/4.0/legalcode},
	url = {https://osf.io/a3pzx_v1},
	doi = {10.31219/osf.io/a3pzx_v1},
	shorttitle = {Chatbots Are Undermining Crowdsourced Research in the Behavioral Sciences},
	abstract = {Generative {AI} poses a significant threat to data integrity on crowdsourcing platforms like Prolific, which behavioral scientists widely rely on for data collection. Large language models ({LLMs}) allow users to generate fluent and relevant responses to open-ended questions, which can mask inattention and compromise experimental validity. To empirically estimate the prevalence of this behavior, we analyzed keystroke data from three studies (N = 928) on Prolific between May and July 2025. Using an embedded {JavaScript} tool, we flagged participants who pasted text or whose keystroke count was anomalously low compared to their response length. For each flagged participant, we manually compared their detected keystrokes to their final response to determine if the text could have been plausibly typed. This process confirmed that, despite deterrence measures, approximately 9\% of all participants submitted {AI}-assisted responses. These participants significantly outperformed non-cheaters (by up to 1.5 {SDs}), were over twice as likely to share geolocations with other participants (suggesting possible {VPN} or proxy use), and exhibited lower reliability on questionnaire scales. Simulated power analyses indicate that this level of undetected cheating can diminish observed effect sizes by 10\% and inflate required sample sizes by as much as 30\%. These findings highlight the urgent need for new detection methods like keystroke logging, which offers verifiable evidence of cheating that is difficult to obtain from manual review of {LLM}-generated text alone. As {AI} continues to evolve, maintaining data quality in crowdsourced research will require active monitoring, methodological adaptation, and communication between researchers and data collection platforms.},
	publisher = {Open Science Framework},
	author = {Asher, Michael W. and Gold, Gillian and Chen, Eason and Carvalho, Paulo F.},
	urldate = {2025-11-05},
